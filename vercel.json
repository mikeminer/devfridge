{
  "ignoreCommand": "node scripts/knowledge/skip-site-build.mjs",
  "services": {
    "bot": {
      "root": "bot",
      "entrypoint": "src/index.ts"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "bot"
      }
    }
  ]
}
