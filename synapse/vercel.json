{
  "framework": null,
  "buildCommand": "npm run build -- --vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/brief.mjs": { "maxDuration": 10, "includeFiles": "snapshot.json" }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/brief?format=html" },
    { "source": "/brief.md", "destination": "/api/brief?format=md" },
    { "source": "/brief.json", "destination": "/api/brief?format=json" },
    { "source": "/llms.txt", "destination": "/api/brief?format=llms" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/mobile.mjs",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" }
      ]
    }
  ]
}
